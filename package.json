{
  "name": "moyai-hub-ui",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421",
    "build": "tsc --noEmit && vite build",
    "test": "node --test --test-reporter=tap ui/test/*.test.ts tests/hub_browser_resource.test.mjs tests/gui_stage.test.mjs",
    "verify:gui": "node scripts/gui-stage.mjs verify",
    "test:gui": "node scripts/gui-stage.mjs test",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
