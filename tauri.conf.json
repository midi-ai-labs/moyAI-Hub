{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moyAI Hub",
  "version": "0.1.0",
  "identifier": "ai.midi.moyai.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "moyAI Hub · Development", "width": 1440, "height": 960, "minWidth": 1000, "minHeight": 720, "resizable": true}],
    "security": {"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
  },
  "bundle": {"active": false, "icon": ["icons/icon.ico", "icons/icon.png"]}
}
